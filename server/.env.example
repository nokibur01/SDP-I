# =========================================================================
# BatchHub Server Environment Configuration Template
# =========================================================================
# Copy this file to .env and configure with secure values.
# NEVER commit .env to version control.
# If credentials have been previously committed or exposed, ROTATE THEM IMMEDIATELY.

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Database Configuration (MariaDB / MySQL)
DB_HOST=localhost
DB_USER=root
# In production, DB_PASSWORD must be non-empty and securely generated
DB_PASSWORD=
DB_NAME=batchhub_db

# JWT Secret Key
# In development: minimum 16 characters.
# In production: MUST be a strong, unpredictable random string of at least 32 characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Production CORS Allowlist (comma-separated origins)
# Example: https://batchhub.university.edu,https://app.batchhub.edu
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# BatchHub Assistant (Google Gemini) — server-side only, never expose to the client
# Create a key at https://aistudio.google.com/apikey and paste it into server/.env (NOT this file)
GEMINI_API_KEY=
# Optional: model to use (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
# Optional: comma-separated backup models tried when the main one is overloaded/unavailable
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Optional: assistant rate limit per client (defaults: 20 messages per 60 seconds)
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
